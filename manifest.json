{
  "manifest_version": 3,
  "name": "X Read-Only",
  "version": "1.0.0",
  "description": "X (Twitter) でポスト・リポストをできなくし、閲覧のみ可能にする",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.twitter.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_write",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}